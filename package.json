{
  "name": "cung-tuyen-api",
  "version": "1.0.0",
  "description": "Cùng Tuyến — Zalo Mini App token exchange proxy server",
  "main": "dist/index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "start:dist": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/copy-schema.mjs",
    "typecheck": "tsc --noEmit",
    "mvc:guardrails": "node scripts/check-mvc-boundaries.mjs",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "test:db": "DATABASE_URL=postgres://postgres:postgres@localhost:5433/share_trip_db tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:schema": "tsx src/db/setup-schema.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:schema:dist": "node dist/db/setup-schema.js",
    "db:seed:dist": "node dist/db/seed.js"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "pg": "8.20.0",
    "tsx": "4.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "25.5.0",
    "@types/pg": "8.20.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.2"
  },
  "packageManager": "yarn@4.14.1+sha512.64df448055b2d37ba269d7db535a469b8da93f8ef1140c25fd7a83c00a8fbaacb214ca0e02553b92a2c54cef78bb67d0b4817fab02001df0e24fac0faccc3b42"
}
