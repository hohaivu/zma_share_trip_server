{
  "name": "cung-tuyen-api",
  "version": "1.0.0",
  "description": "Cùng Tuyến — Zalo Mini App token exchange proxy server",
  "main": "dist/index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "start:dist": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/copy-schema.mjs",
    "typecheck": "tsc --noEmit",
    "mvc:guardrails": "node scripts/check-mvc-boundaries.mjs",
    "test": "DATABASE_URL=mariadb://mariadb:mariadb@127.0.0.1:3307/share_trip_db tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "db:schema": "tsx src/db/setup-schema.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:schema:dist": "node dist/db/setup-schema.js",
    "db:migrate:dist": "node dist/db/migrate.js",
    "db:seed:dist": "node dist/db/seed.js",
    "db:truncate": "tsx src/db/truncate.ts"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "5.2.1",
    "mariadb": "^3.4.0",
    "tsx": "4.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "25.5.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.2"
  }
}
